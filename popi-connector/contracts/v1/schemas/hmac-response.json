{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://popisite.cz/contracts/popi-connector/v1/schemas/hmac-response.json",
  "title": "POPI Connector signed response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "key_id", "timestamp", "nonce", "request_id", "status", "payload_b64", "signature"],
  "properties": {
    "protocol": { "const": "popi-hmac-v1" },
    "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,191}$" },
    "timestamp": { "type": "integer", "minimum": 1 },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,96}$" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{3,191}$" },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "payload_b64": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "x-content-encoding": "base64url-json" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{40,96}$" }
  }
}
