{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://popisite.cz/contracts/popi-connector/v1/schemas/binding.json",
  "title": "POPI Connector binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["binding_id", "connection_id", "tenant_id", "project_id", "installation_id", "module", "scopes", "config"],
  "properties": {
    "binding_id": { "type": "string", "minLength": 3, "maxLength": 191 },
    "connection_id": { "type": "string", "minLength": 3, "maxLength": 191 },
    "tenant_id": { "type": "string", "minLength": 3, "maxLength": 191 },
    "project_id": { "type": "string", "minLength": 3, "maxLength": 191 },
    "installation_id": { "type": "string", "minLength": 3, "maxLength": 191 },
    "module": { "enum": ["popiweb", "popicast"] },
    "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 100 } },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_post_types", "allowed_meta_keys", "allowed_write_fields", "allowed_statuses", "verified_frontend_hosts"],
      "properties": {
        "allowed_post_types": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_.-]{1,100}$" } },
        "allowed_meta_keys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_.-]{1,100}$" } },
        "allowed_write_fields": { "type": "array", "uniqueItems": true, "items": { "enum": ["title", "content", "excerpt", "status", "meta"] } },
        "allowed_statuses": { "type": "array", "uniqueItems": true, "items": { "enum": ["publish", "draft", "pending", "private", "future"] } },
        "verified_frontend_hosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "hostname" } }
      }
    }
  }
}
